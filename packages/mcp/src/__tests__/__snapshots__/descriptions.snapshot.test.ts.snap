                      ],
                    },
                    "description": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "title": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "truncated": {
                      "items": {
                        "enum": [
