                      ],
                    },
                  },
                  "required": [
                    "status",
                    "statusCategory",
                    "board",
                    "assignees",
                    "dueAt",
                    "overdue",
                  ],
                  "type": "object",
                },
                "type": {
                  "enum": [
                    "Need",
                    "Resource",
                    "Opportunity",
                    "Insight",
                    "Tension",
                    "Risk",
                    "Action",
                    "Impact",
                    "Bug",
                    "Trend",
                    "Proposal",
                  ],
                  "type": "string",
                },
                "updatedAt": {
                  "type": "string",
                },
                "upvotes": {
                  "additionalProperties": false,
                  "properties": {
                    "downCount": {
                      "type": "number",
                    },
                    "totalVotingPower": {
                      "type": "string",
                    },
                    "upCount": {
                      "type": "number",
                    },
                    "votingPowerDecimals": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "upCount",
                    "downCount",
                    "totalVotingPower",
                    "votingPowerDecimals",
                  ],
                  "type": "object",
                },
                "url": {
                  "type": "string",
                },
                "userText": {
                  "additionalProperties": false,
                  "properties": {
                    "creatorName": {
                      "type": [
                        "string",
