                },
                "slug": {
                  "type": "string",
                },
                "tags": {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                "taskFields": {
                  "additionalProperties": false,
                  "description": "Legacy, from when signals doubled as tasks; kept for the migration period. The task status (and its category), the board, the assignees’ display names, the due date and whether it has passed. Not part of what a signal is.",
                  "properties": {
                    "assignees": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "board": {
                      "type": "string",
                    },
                    "dueAt": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "overdue": {
                      "type": "boolean",
                    },
                    "status": {
                      "type": "string",
                    },
                    "statusCategory": {
                      "type": [
                        "string",
