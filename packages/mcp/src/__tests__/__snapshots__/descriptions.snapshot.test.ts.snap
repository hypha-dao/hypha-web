              ],
              "type": "object",
            },
            "maxItems": 1,
            "type": "array",
          },
          "pageSize": {
            "description": "Spaces per page, 1 to 50. Default 20.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
          },
          "parentOnly": {
            "description": "Only top-level spaces, not sub-spaces. Default false.",
            "type": "boolean",
          },
          "query": {
            "description": "Keyword to search in space titles and descriptions. Omit to list every visible space.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
        },
        "type": "object",
      },
