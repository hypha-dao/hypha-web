    {
      "_meta": undefined,
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Create a signal in one Hypha space for the signed-in user: something they want the space to notice, such as a need, a risk, an opportunity or a tension. A signal commits nobody; the members of the space see it and discuss it. Use it only when the user asked for it. If you drafted the title, description or type yourself, show them to the user and get their confirmation first. Put a link in the description only if it comes from the user’s own request. The user must be a member or a delegate of the space and must have allowed this app to create signals. Never guess a slug: find the space with \`hypha_list_spaces\` and \`query\` first. Hypha records which app created the signal in its \`origin\`; it adds no tag of its own and notifies nobody. \`duplicate: true\` means this app already created the same title and description for the user in this space within the last 10 minutes: that signal is returned and nothing new was written, so do not call again. Share the \`url\` with the user; they can edit or delete the signal in Hypha.",
      "execution": undefined,
      "icons": undefined,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "description": {
            "description": "What the signal is about, 1 to 4,000 characters. Markdown is shown formatted in Hypha.",
            "maxLength": 4000,
            "minLength": 1,
            "type": "string",
          },
          "spaceSlug": {
            "description": "The space slug, as returned by \`hypha_list_spaces\`.",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string",
          },
          "tags": {
            "description": "Optional keywords, at most 10, each up to 40 characters. Prefer tags the space already uses (see \`hypha_list_signals\`).",
            "items": {
              "maxLength": 40,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "title": {
            "description": "A short title, 1 to 50 characters.",
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
          },
          "type": {
            "description": "What kind of signal: \`Need\`, \`Resource\`, \`Opportunity\`, \`Insight\`, \`Tension\`, \`Risk\`, \`Action\`, \`Impact\` or \`Bug\`.",
            "enum": [
              "Need",
              "Resource",
              "Opportunity",
              "Insight",
              "Tension",
              "Risk",
              "Action",
              "Impact",
              "Bug",
            ],
            "type": "string",
          },
        },
        "required": [
          "spaceSlug",
          "type",
          "title",
          "description",
        ],
        "type": "object",
      },
      "name": "hypha_create_signal",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "type": "string",
          },
          "duplicate": {
            "description": "True when nothing new was written: the same content was created by this app for the user in this space within the last 10 minutes, and that signal is returned.",
            "type": "boolean",
          },
          "origin": {
            "additionalProperties": false,
            "description": "The path that created this signal, recorded by Hypha: \`mcp_client\` and this app’s self-declared name.",
            "properties": {
              "clientName": {
                "type": [
                  "string",
                  "null",
                ],
              },
              "kind": {
                "enum": [
                  "app",
                  "hypha_assistant",
                  "mcp_client",
                  "api_client",
                  "space_key",
                  "hypha_intelligence",
                  "hypha_platform",
                  "unknown",
                ],
                "type": "string",
              },
            },
            "required": [
              "kind",
              "clientName",
            ],
            "type": "object",
          },
          "slug": {
            "type": "string",
          },
          "spaceSlug": {
            "type": "string",
          },
          "tags": {
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "type": {
            "type": "string",
          },
          "url": {
            "type": "string",
          },
          "userText": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": [
                  "string",
                  "null",
                ],
              },
              "title": {
                "type": [
                  "string",
                  "null",
                ],
              },
              "truncated": {
                "items": {
                  "enum": [
                    "title",
                    "description",
                  ],
                  "type": "string",
                },
                "type": "array",
              },
            },
            "required": [
              "title",
              "description",
              "truncated",
            ],
            "type": "object",
          },
        },
        "required": [
          "slug",
          "url",
