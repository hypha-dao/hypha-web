            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string",
          },
          "spaceSlug": {
            "description": "The space slug, as returned by \`hypha_list_spaces\`.",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string",
          },
        },
        "required": [
          "spaceSlug",
          "documentSlug",
        ],
        "type": "object",
      },
