# ─── Database ────────────────────────────────────────────────────────────────
# Shared with Hypha: the campaign reads and writes the same `people` table so a
# member has one identity across both. BRANCH_DB_URL wins when both are set.
DEFAULT_DB_URL=
BRANCH_DB_URL=

# ─── Privy ───────────────────────────────────────────────────────────────────
# Same app as Hypha, so the same `sub` resolves to the same person.
NEXT_PUBLIC_PRIVY_APP_ID=cm5y07p2z02napk1cutzzx7o6
PRIVY_APP_SECRET=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated. Checked server-side on every admin endpoint against the
# email on the Privy login.
CAMPAIGN_ADMIN_EMAILS=

# ─── Campaign economics ──────────────────────────────────────────────────────
CAMPAIGN_JOIN_BONUS_RSUT=50
CAMPAIGN_RSUT_PER_AUD=1
CAMPAIGN_MIN_CONTRIBUTION_AUD=5
CAMPAIGN_MAX_CONTRIBUTION_AUD=25000

# ─── RSUT on Base ────────────────────────────────────────────────────────────
# RSUT is a Hypha DecayingSpaceToken owned by the RS Core Team executor at
# 0xEc5106fb6eA212305e487a9114c958ffE90E9a7a. Before the relayer can mint, that
# executor must call batchSetAuthorizedMinters([relayer], [true]) once.
# Leave the key blank and the app still works — grants are recorded and votes
# count, the mints just stay pending until a relayer exists.
RSUT_TOKEN_ADDRESS=0xaacf3eb65badeebf3206c5d241b851c7c8fc2ac1
RSUT_RELAYER_PRIVATE_KEY=
RSUT_CHAIN_ID=8453
RPC_URL=https://mainnet.base.org

# ─── Checkout ────────────────────────────────────────────────────────────────
# mock | paddle | stripe. `mock` runs the whole contribute → grant → mint path
# locally with a signed fake webhook, so the choice between Paddle and Stripe
# can stay open.
CAMPAIGN_PAYMENTS_PROVIDER=mock
CAMPAIGN_MOCK_PAYMENT_SECRET=

# Paddle Billing (Merchant of Record — note the DGR receipting implication)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
# Used to build checkout return URLs and the mock webhook callback.
NEXT_PUBLIC_APP_URL=http://localhost:3002
