# ─── Database ────────────────────────────────────────────────────────────────
# The campaign's own database — a separate Neon project, NOT Hypha's. Every
# table it owns is prefixed `campaign_` and lives only here, so nothing this app
# does can reach the platform database.
#
# The name is deliberately not one of Hypha's (`DEFAULT_DB_URL`, `BRANCH_DB_URL`,
# …): those are never read by this app, so there is no misconfiguration that
# quietly points the campaign at Hypha. Setting this to a Hypha connection
# string is detected and refused at startup.
CAMPAIGN_DB_URL=

# ─── Privy ───────────────────────────────────────────────────────────────────
# Same app as Hypha, so a contributor who also uses Hypha carries the same `sub`
# in both and the two can be correlated later. The campaign still stores its own
# `campaign_members` row; it never reads or writes Hypha's `people` table.
NEXT_PUBLIC_PRIVY_APP_ID=cm5y07p2z02napk1cutzzx7o6
PRIVY_APP_SECRET=

# ─── Hypha profile enrichment (optional, read-only) ──────────────────────────
# Where to look up a contributor's Hypha profile so the admin ledger can show a
# name instead of an email. Unauthenticated GET only — the campaign has no
# credential for Hypha and cannot write to it. Unset or unreachable simply means
# no enrichment; contributions are unaffected.
HYPHA_BASE_URL=https://app.hypha.earth

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated. Checked server-side on every admin endpoint against the
# email on the Privy login.
CAMPAIGN_ADMIN_EMAILS=

# ─── Campaign economics ──────────────────────────────────────────────────────
CAMPAIGN_JOIN_BONUS_RSUT=50
CAMPAIGN_RSUT_PER_AUD=1
CAMPAIGN_MIN_CONTRIBUTION_AUD=5
CAMPAIGN_MAX_CONTRIBUTION_AUD=25000

# ─── RSUT on Base ────────────────────────────────────────────────────────────
# RSUT is the Hypha space token for space 889. `mint` is gated on
# `msg.sender == executor || isAuthorizedMinter[msg.sender]`, and the proxy is
# still on a build that predates isAuthorizedMinter — so the relayer cannot mint
# until the owner runs:
#   node packages/storage-evm/scripts/rsut-upgrade.mjs --relayer 0x… --execute
# Leave the key blank and the app still works: grants are recorded and votes
# count, the mints just stay pending until the relayer is authorised.
RSUT_TOKEN_ADDRESS=0xaacf3eb65badeebf3206c5d241b851c7c8fc2ac1
RSUT_RELAYER_PRIVATE_KEY=
RSUT_CHAIN_ID=8453
RPC_URL=https://mainnet.base.org

# ─── Checkout ────────────────────────────────────────────────────────────────
# mock | paddle | stripe. Stripe is the chosen provider; `mock` still runs the
# whole contribute → grant → mint path locally with a signed fake webhook, which
# is handy when you have no Stripe keys to hand.
CAMPAIGN_PAYMENTS_PROVIDER=stripe
CAMPAIGN_MOCK_PAYMENT_SECRET=

# Stripe Checkout. A restricted key (rk_test_…) is enough — creating a Checkout
# Session is the only write the app makes. Add "Debugging Tools write" to it if
# you also want `stripe listen` to work with the same key. The app reports test
# vs live on the admin screen, and `stripe:check` refuses a live key.
# The webhook secret comes from `stripe listen` locally, or from the endpoint
# you add in the dashboard once deployed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paddle Billing — kept wired but unused (Merchant of Record, which complicates
# DGR receipting; that is part of why Stripe won).
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# ─── App ─────────────────────────────────────────────────────────────────────
# Used to build checkout return URLs and the mock webhook callback.
NEXT_PUBLIC_APP_URL=http://localhost:3002
