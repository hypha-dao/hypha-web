{
  "name": "regen-sydney",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "node scripts/db-check.mjs",
    "seed": "NODE_OPTIONS='--conditions=react-server' tsx --env-file-if-exists=.env src/server/campaign/seed.ts",
    "db:check:deployed": "node scripts/db-check.mjs .env.neon",
    "db:migrate:deployed": "node --env-file=.env.neon ./node_modules/drizzle-kit/bin.cjs migrate",
    "seed:deployed": "NODE_OPTIONS='--conditions=react-server' tsx --env-file=.env.neon src/server/campaign/seed.ts",
    "stripe:check": "node scripts/stripe-check.mjs",
    "postinstall": "if [ ! -f .env ] && [ -z \"$CI\" ]; then cp .env.template .env; fi",
    "test": "vitest run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@privy-io/react-auth": "^2.20.0",
    "@privy-io/node": "^0.12.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.4",
    "ws": "^8.18.1",
    "lucide-react": "^0.469.0",
    "next": "^15.4.8",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "server-only": "^0.0.1",
    "swr": "^2.2.5",
    "tailwind-merge": "^3.0.2",
    "viem": "^2.27.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@hypha-platform/config-eslint": "workspace:*",
    "@hypha-platform/config-typescript": "workspace:*",
    "eslint": "^9.24.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.30.5",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^1.3.1"
  }
}
